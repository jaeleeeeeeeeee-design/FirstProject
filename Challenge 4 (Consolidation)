import SwiftUI

struct ContentView: View {
    @State private var game = ["Rock", "Paper", "Scissors"]
    @State private var computerChoice = Int.random(in: 0...2)
    @State private var shouldWin = Bool.random()
    
    @State private var scoreTitle = ""
    @State private var showingScore = false
    @State private var userScore: Int = 0
    @State private var finalScore = false
    @State private var count: Int = 0
    @State private var finalMessage = ""
    
    var body: some View {
        ZStack {
            VStack {
                Spacer()
                
                VStack {
                    Text("Let's play rock, paper, scissors!")
                    
                        
                        
                        VStack {
                            Text("\(game[computerChoice]), ")
                            
                            VStack {
                                ForEach(0..<3, id: \.self) { choice in
                                    Button {
                                        results(choice)
                                    } label: {
                                        Text(game[choice])
                                    }
                                }
                            }
                            .foregroundStyle(Color.blue)
                            .frame(width: 200, height: 200)
                            Text(shouldWin ? "You Win!" : "You Lose!")
                        }
                }
                Spacer()
                
                Text("Your score: \(userScore)")
            }
        }
        .alert(scoreTitle, isPresented: $showingScore) {
            Button("Continue", action: resetScore)
        } message: {
            Text("Your score is \(userScore)")
        }
        
        .alert(finalMessage, isPresented: $finalScore) {
            Button("Reset") {
                userScore = 0
                count = 0
                resetScore()
            }
        }
    }
    
    func results(_ choice: Int) {
        if shouldWin == true {
            if (computerChoice, choice) == (0, 1) ||
                (computerChoice, choice) == (1, 2) ||
                (computerChoice, choice) == (2, 0) {
                scoreTitle = "Correct!"
                userScore += 10
            } else {
                scoreTitle = "Wrong!"
                userScore -= 5
                
            }
        } else {
            if (computerChoice, choice) == (0, 2) ||
                (computerChoice, choice) == (1, 0) ||
                (computerChoice, choice) == (2, 1) {
                scoreTitle = "Correct!"
                userScore += 10
            } else {
                scoreTitle = "Wrong!"
                userScore -= 5
            }
        }
        shouldWin.toggle()
        showingScore = true
    }
        
    func resetScore() {
        if count < 10 {
            computerChoice = Int.random(in: 0...2)
            shouldWin = Bool.random()
            count += 1
        } else {
            finalMessage = "Game over, your score is \(userScore)"
            finalScore = true
        }
    }
}

